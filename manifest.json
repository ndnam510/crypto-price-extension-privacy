{
  "manifest_version": 3,
  "name": "Crypto Quick Check Tooltip",
  "version": "5.0.0",
  "description": "Highlight ticker (BTC,ETH.), right-click to see price. Chrome Extension page blocks extensions. Use the extension on other websites",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.coingecko.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["coingeckoid.csv"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
 "action": {
    "default_popup": "popup.html"
  }
}